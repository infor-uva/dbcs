# Example Environment Configuration File
# Copy this file to .env and fill in the actual values
# Never commit the .env file to version control

#######################################
# OAuth2 Provider Credentials
#######################################
# GitHub OAuth App (create at https://github.com/settings/developers)
OAUTH2_GITHUB_CLIENT_ID=your_github_client_id
OAUTH2_GITHUB_SECRET=your_github_client_secret

# Google OAuth (create at https://console.cloud.google.com/apis)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

#######################################
# Database Configuration
#######################################
DB_HOST=localhost
DB_PORT=3306
DB_NAME=Auth
DB_USERNAME=user
DB_PASSWORD=password

#######################################
# Redis Configuration
#######################################
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

#######################################
# JWT Configuration
#######################################
JWT_SECRET_KEY=your_secret_key_here_minimum_32_characters
JWT_KID=key_id_identifier
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

#######################################
# CORS Configuration
#######################################
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

#######################################
# Auth Service Configuration
#######################################
AUTH_SERVICE_ISSUER=http://localhost:8101
AUTH_SERVICE_PORT=8101

#######################################
# Key Rotation Configuration
#######################################
JWT_KEY_ROTATION_ENABLED=true
JWT_KEY_ROTATION_INTERVAL_DAYS=30
JWT_KEY_ROTATION_GRACE_PERIOD_DAYS=30

#######################################
# Audit Logging Configuration
#######################################
AUDIT_RETENTION_DAYS=90

#######################################
# Logging Configuration
#######################################
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=DEBUG

#######################################
# Docker Compose Configuration
#######################################
KONG_PG_PASSWORD=kong_password

#######################################
# API Endpoints (for microservices)
#######################################
API_AUTH_HOSTNAME=auth-api
API_AUTH_PORT=8101
API_AUTH_URL=http://${API_AUTH_HOSTNAME}:${API_AUTH_PORT}

API_BOOKINGS_HOSTNAME=bookings-api
API_BOOKINGS_PORT=8401
API_BOOKINGS_URL=http://${API_BOOKINGS_HOSTNAME}:${API_BOOKINGS_PORT}

API_HOTELS_HOSTNAME=hotels-api
API_HOTELS_PORT=8301
API_HOTELS_URL=http://${API_HOTELS_HOSTNAME}:${API_HOTELS_PORT}

API_USERS_HOSTNAME=users-api
API_USERS_PORT=8201
API_USERS_URL=http://${API_USERS_HOSTNAME}:${API_USERS_PORT}

